#!/usr/bin/env bash
# Python of the Research-Agent venv (numpy, pandas, matplotlib, ... for ARIS helper scripts).
for py in "$HOME/.research-agent/venv/bin/python" "$HOME/.research-agent/venv/Scripts/python.exe" python3; do
  [ -x "$py" ] || command -v "$py" >/dev/null 2>&1 || continue
  exec "$py" "$@"
done
exit 1
