#!/usr/bin/env bash
# Research-Agent CLI wrapper: runs `python -m research_agent` from this plugin checkout.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$HERE/src${PYTHONPATH:+:$PYTHONPATH}"
export CLAUDE_PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$HERE}"
for py in "$RA_PYTHON" "$HOME/.research-agent/venv/bin/python" "$HOME/.research-agent/venv/Scripts/python.exe" python3 "py -3" python; do
  [ -z "$py" ] && continue
  if $py -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
    exec $py -m research_agent "$@"
  fi
done
echo "Research-Agent needs Python >= 3.11" >&2
exit 1
